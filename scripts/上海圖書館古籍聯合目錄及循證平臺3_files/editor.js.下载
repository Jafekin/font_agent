$(function() {

	var editorTpl = $("#editorTpl").html();
	var searchCdtn = {};
	var pagerCallBack = function(page_id){
		searchCdtn['pageth'] = page_id;
		isfacet = false;
		search();
	}
	var search = function(){
				showLoading();
				var params = {};
				$.extend(params, searchCdtn);
				$.get(indexBaseUrl + "/api/workSearchSmpl", params, function(
						result) {
					result = JSON.parse(result);
					//console.log(result);
						$(".scroll-sm").html(juicer(editorTpl, result))
								.animateCss("fadeIn");
						$("#pager").pagination(result.pager, pagerCallBack);
						$('.go-to-page').pagination({
							pageCount : result.pager.pageCount,
							jump: true,
				            coping: true,
				            current: result.pager.pageth,
				            homePage: '首页',
				            activeCls:"cur",
				            jumpBtn:"GO",
				            mode:"fixed",
				            endPage: '末页',
				            prevContent: '上页',
				            nextContent: '下页',
							callback : function(api) {
//								alert(api.getCurrent());
								searchCdtn['pageth'] = api.getCurrent();
								search(false);
							}
						});
					hideLoading();

					return false;
			});
		}
				function submitForm(){
					$("#searchForm").submit();
				}
	
			$("#searchForm").submit(function() {
				searchCdtn = $(this).serializeObject();
			    searchCdtn['pageth'] = 1;
			    search();
			    return false;
			});
		
			$("#editbtn").on("click", function() {
				searchCdtn['pageth'] = 1;
				submitForm();
			})
		
			$("#btn_query").on("click", function() {
				$("#searchForm").submit();
			});
		
			//弹框
			$(".edit").click(function() {
				$(".search-box").fadeIn();
			})
		
			$(".tk-box-bg").click(function() {
				$(this).parent().fadeOut();
			})
			$(".cls-tk-btn").click(function() {
				$(this).parent().parent().fadeOut();
				window.location.reload();
			})
			$(".refresh").click(function() {
				window.location.reload();
			})
			
			//alert(PARAM_MGR.getParam("uri"));
			var instanceUri='';
			var workUri = '';
			
			$('.scroll-sm').delegate('a', 'click', function(){
				workUri = $(this).attr('data');
				instanceUri=PARAM_MGR.getParam("uri");
				$('.errMsg').text('');
				$(".inner-tk").fadeIn()
				
				return false;
			})
			
			$('#btn_confirm').on('click', function(){
				var note = $.trim($('#editNote').val());
				if(note == ''){
					$('.errMsg').text('請填寫修改意見！');
					return false;
				}
				showConfirmMsg(String.format(IMSG0003,"確定保存？"), saveFunction);
				
				return false;
			})
			
			var  saveFunction= function(){
				var params = {};
				params['instanceUri'] = instanceUri;
				params['workUri'] = workUri;
				params['editNote'] = $.trim($('#editNote').val());
				$.post(ctx+'/dataEdit/updateInstanceOf',params,function(result){
					if(result == 'success'){
						//var index = parent.layer.getFrameIndex(window.name); //获取窗口索引
						parent.location.reload();
						parent.layer.close(index);
					}
					else{
						showErrorMsg(String.format(EMSG9000, "导入"));
					}
				});
			}

});