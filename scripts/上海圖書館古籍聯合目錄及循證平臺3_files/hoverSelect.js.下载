$(".nav-div-a").children(":first").hover(function() {
	if($(this).next("div.hoverSelect").is(":hidden"))
		$(this).next("div.hoverSelect").show();
}, function() {
	$(this).next("div.hoverSelect").hide();
});

$("div.hoverSelect").hover(function() {
	$(this).show();
}, function() {
	$(this).hide();
});