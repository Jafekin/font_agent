function swiper_fun(a,b,c){
    var tap=0;
    var size= a.length;
    var ele= a.parent();
    var w=parseInt(a.parent().parent().width());
    b.click(function(){
        if(tap>0){
            tap--;
            ele.animate({"left":-tap*w},500)
        }
    })
    c.click(function(){
        if(tap<size-1){
            tap++;
            ele.animate({"left":-tap*w},500)
        }
    })
    $(window).resize(function(){
        w=parseInt(a.parent().parent().width());
        ele.animate({"left":-tap*w},500)
    })
}

function buildJumpUrl(params, url){
	var pathname = url || window.location.pathname;
	var search = '';
	var conn = '?';
	for(var key in params){
		if(params[key] != ''){
			search += conn + key + '=' + encodeURI(params[key]);
			conn = '&';
		}
	}
	return pathname + search;
}

