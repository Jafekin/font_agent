
    var remoteAutoComplete = function(selector){
        	selector.typeahead({
                source: function (query, process) {
                    //query是输入的值
                	var suggestField = selector.prev().find('.dropdown-menu li a.cur').attr('data-sugg');
                	if(suggestField){
	                    $.get(indexBaseUrl + '/api/gjsuggest/', { query: query, field: suggestField}, function (res) {
	                    	res = JSON.parse(res);
	                    	console.log(res);
	                        process(res.datas ? res.datas : []);
	                    });
                	}
                },
                matcher: function (item) { 
                    return true ;
                },
                delay: 500,
                fitToElement: true,
                autoSelect: false,
                afterSelect: function(item){
//                	console.log(item);
//                	selector.val(item);
                	$('.sch').click();
                }
            });
    }


    var remoteRagAutoComplete = function(selector){
