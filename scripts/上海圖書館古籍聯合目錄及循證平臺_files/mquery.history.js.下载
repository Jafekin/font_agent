function listQueryHistory(){
	//获取检索历史列表
	var queryHistoryList = [];
	var queryFuncNo = $('#queryFuncNo').val();
	queryHistoryList = getQueryHistorys(queryFuncNo);
	if(ctxRoleId){
		$.ajaxSettings.async = false;
		
		$.get(ctx+'/service/search/history/get', {funcNo: queryFuncNo}, function(result){
			if(result.data && result.data.length > 0){
				queryHistoryList = result.data;
			}
		});
		
		$.ajaxSettings.async = true;
	}
	
	//加载检索历史
	if(queryHistoryList && queryHistoryList.length > 0){
		for(var i=queryHistoryList.length; i>0; i--){
			paintHisotry(queryHistoryList[i-1]);
		}
	}else{
		$('.seach-his-list').hide();
	}
	
}

$(function(){
	listQueryHistory();
	
	$('.saveQuery').click(function(){
