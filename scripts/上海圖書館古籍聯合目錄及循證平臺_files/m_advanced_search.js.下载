	var buildSearchCdtn = function(){
		searchCdtn.cdtn = [];
		searchCdtn.searchType = $('.search-input-box .genealogySearchTab .cur').attr("data-id");
		if(searchCdtn.searchType == '1'){
			var cdtn = {logic:"", field: $('.simple-ipt .input-group-btn .dropdown-menu .cur').attr('data-field'), value: $('.simple-ipt input.simple-search-input').val(), type: "0"};
			searchCdtn.cdtn.push(cdtn);
		}else if(searchCdtn.searchType == '2'){
			$('.adv-ipt .cdtn-row').each(function(){
				var cdtn = {
					logic: $(this).find('select').val() || "",
					field: $(this).find('.dropdown-menu.ul-fields .cur').attr('data-field'),
					value: $(this).find('.adv-search-input').val(),
					type: $(this).find('.dropdown-menu.ul-types .cur').attr('data-val'),
				}
				searchCdtn.cdtn.push(cdtn);
			});
		}
		if(searchCdtn.searchType != '3'){
			searchCdtn.expression = '';
			for(var i=0; i<searchCdtn.cdtn.length; i++){
				if($.trim(searchCdtn.cdtn[i].value))
//					searchCdtn.expression += searchCdtn.cdtn[i].logic + " " + searchCdtn.cdtn[i].field + (searchCdtn.cdtn[i].type == '1' ? '=' : ':') + '"' + searchCdtn.cdtn[i].value + '"';

					searchCdtn.expression += (searchCdtn.cdtn[i].logic == 'not' ? 'and' : searchCdtn.cdtn[i].logic) + " " + searchCdtn.cdtn[i].field 
						+ (searchCdtn.cdtn[i].logic == 'not' ? '!' : '')
						+ (searchCdtn.cdtn[i].type == '1' ? '=' : ':') + '"' + searchCdtn.cdtn[i].value + '"';
			}

			if(searchCdtn.expression.startWith('and')){
				searchCdtn.expression = searchCdtn.expression.substring(3);
			}
		}else{
			searchCdtn.expression = $('.spec-ipt textarea').val();
		}
	}
	
