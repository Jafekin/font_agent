	var buildCharts = function(dataTag, result, title){
		var chartsData = [];
		var barChartsX = [];
		var barChartsY = [];
		for(var i = 0; i<facetData[dataTag].facets.length; i++){
			chartsData.push(facetData[dataTag].facets[i]);
			barChartsX.push(facetData[dataTag].facets[i].facet);
			barChartsY.push(facetData[dataTag].facets[i].count);
		}
		for(var i = 0; i<facetData[dataTag].facetsOther.length; i++){
			if(facetData[dataTag].facetsOther[i].count != '0'){
				chartsData.push(facetData[dataTag].facetsOther[i]);
				barChartsX.push(facetData[dataTag].facetsOther[i].facet);
				barChartsY.push(facetData[dataTag].facetsOther[i].count);
			}
		}
		strContent = '<div id="charts" style="width:100%;height:500px;"></div>';
			layer.open({
				type : 1,
				title : title,
				shadeClose : true,
				shade : 0.8,
				area : [ '70%', '550px' ],
				content : strContent
			});
		var charts = echarts.init(document.getElementById('charts'));
		option = {
		    title : {
		        text: $(this).attr('data-type'),
	            x:'center'
		    },
		    tooltip : {
		        trigger: 'axis',
		        axisPointer : {            // 坐标轴指示器，坐标轴触发有效
		            type : 'shadow'        // 默认为直线，可选为：'line' | 'shadow'
		        }
		    },
		    calculable : true,
		    xAxis : [
		        {
		            type : 'category',
		            data : barChartsX,
		            axisLabel: {
		                interval: 0,
		                rotate: 30
		            }
		        }
		    ],
		    yAxis : [{
			            type : 'value'
			        }
		         ],
		    series : [
		        {
		            name:'',
		            type:'bar',
		            data:barChartsY
		        }
		    ]
		};
		charts.setOption(option);
		
		charts.on('click', function (params) {
			if (params.componentType === 'series') {
				facetCdtn = {};
				facetCdtn[facetData[dataTag].type]=chartsData[params.dataIndex].facet;
				searchCdtn['pageth'] = 1;
				isfacet = false;
				search();
			}
		});
	}
	
